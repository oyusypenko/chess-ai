# ChessCoach AI — environment. Copy to .env.local; never commit real values.

# --- Lichess OAuth (US-A2) ------------------------------------------------
# Public client: there is NO client secret. PKCE is what protects the flow.
# The client id is any stable string identifying this app to Lichess.
LICHESS_CLIENT_ID=chesscoach-ai
# Optional; defaults to <origin>/api/auth/callback.
# LICHESS_REDIRECT_URI=https://your-domain/api/auth/callback

# --- Token encryption at rest (US-A2, NFR-S1) -----------------------------
# 32 random bytes, base64. Generate with: npm run gen:key
# Without it the app REFUSES to store OAuth tokens rather than writing plaintext.
TOKEN_ENCRYPTION_KEY=

# --- LLM provider (US-D1, FR-4) -------------------------------------------
# Absent -> every report degrades to engine-only, which is correct per NFR-R1
# but not the intended experience.
ANTHROPIC_API_KEY=

# --- Local database -------------------------------------------------------
# Only used outside Cloudflare; in production the D1 binding is used instead.
# LOCAL_DB_PATH=.data/chess-ai.sqlite
